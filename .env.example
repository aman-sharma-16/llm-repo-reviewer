# ============================================
# API Tokens
# ============================================
# Copy this file to .env.local and add your tokens
# Note: VITE_ prefix is required for Vite to expose these to the client

# GitHub API Token (Optional)
# Get from: https://github.com/settings/tokens
VITE_GITHUB_API_TOKEN=your_github_personal_access_token_here

# Google API Key (Required for code analysis)
# Get from: https://console.cloud.google.com
VITE_GOOGLE_API_KEY=your_google_api_key_here
